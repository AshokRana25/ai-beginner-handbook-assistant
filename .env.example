# Copy to .env locally. Never commit or share your populated .env.
# Optional Confluence settings. Leave blank for manual file import only.
# Use your own approved tenant URL and numeric page ID; never publish them here.
# Example URL format: https://your-company.atlassian.net/wiki
CONFLUENCE_BASE_URL=
CONFLUENCE_ROOT_ID=
CONFLUENCE_EMAIL=your.work.email@example.com
CONFLUENCE_API_TOKEN=replace_with_your_own_confluence_token

# Local models only. The application rejects remote/cloud Ollama endpoints and models.
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:4b
EMBEDDING_MODEL=qwen3-embedding:0.6b
CHUNK_SIZE=1600
CHUNK_OVERLAP=200
TOP_K=5
MIN_SIMILARITY=0.30
CONTEXT_TOKENS=8192

# Optional: absolute path to a private, non-synced folder on this computer.
# DATA_DIR=C:/Users/your-name/AppData/Local/AIHandbookAssistant/data
